{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/login/", "destination": "/login/index.html" },
    { "source": "/signup", "destination": "/signup/index.html" },
    { "source": "/signup/", "destination": "/signup/index.html" },
    { "source": "/forgot-password", "destination": "/forgot-password/index.html" },
    { "source": "/forgot-password/", "destination": "/forgot-password/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/:path*", "destination": "/dashboard/:path*/index.html" }
  ]
}
